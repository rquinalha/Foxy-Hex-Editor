{
    "name": "foxy-hex-editor",
    "version": "1.1.0",
    "description": "Foxy Hex Editor - Editor Hex Avançado e Ferramentas de Tradução",
    "main": "electron/main.js",
    "scripts": {
        "start": "electron .",
        "test:search": "node tools/tests/search-regression.js",
        "test:editor": "node tools/tests/editor-integration.js",
        "build": "electron-builder",
        "dist": "electron-builder --publish=never",
        "portable": "node scripts/build-portable.cjs",
        "appimage": "electron-builder --linux AppImage --publish=never"
    },
    "author": "Foxy Editor",
    "license": "GPL-3.0",
    "dependencies": {
        "iconv-lite": "^0.6.3"
    },
    "devDependencies": {
        "electron": "43.2.0",
        "electron-builder": "25.1.8"
    },
    "build": {
        "appId": "com.foxyeditor.hex",
        "productName": "Foxy Hex Editor",
        "directories": {
            "output": "dist"
        },
        "files": [
            "index.html",
            "LICENSE",
            "assets/**",
            "css/**",
            "electron/**",
            "js/**",
            "tools/**",
            "!tools/tests/**"
        ],
        "win": {
            "target": [
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "assets/icon.ico",
            "publisherName": "Foxy Hex Editor"
        },
        "linux": {
            "artifactName": "FoxyHexEditor-${version}-linux-${arch}.${ext}",
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "assets/foxy.png",
            "category": "Development",
            "maintainer": "Foxy Hex Editor Contributors"
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "icon": "assets/foxy.png",
            "category": "public.app-category.developer-tools"
        },
        "portable": {
            "artifactName": "FoxyHexEditor-${version}-portable.${ext}"
        }
    }
}
